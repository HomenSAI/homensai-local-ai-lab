ARG CUDA_VERSION=12.8.1
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS build

ARG STABLE_DIFFUSION_CPP_COMMIT=3f8527a46c54ecf4cb4ed6003da8e8982283c73c
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git cmake ninja-build build-essential pkg-config libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git init . \
    && git remote add origin https://github.com/leejet/stable-diffusion.cpp.git \
    && git fetch --depth 1 origin "${STABLE_DIFFUSION_CPP_COMMIT}" \
    && git checkout --detach FETCH_HEAD \
    && git submodule update --init --recursive

RUN cmake -S . -B build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DSD_CUDA=ON \
      -DSD_BUILD_EXAMPLES=ON \
      -DSD_BUILD_TESTS=OFF \
      -DSD_WEBP=OFF \
      -DSD_WEBM=OFF \
      -DCMAKE_CUDA_ARCHITECTURES=86 \
      -DCMAKE_EXE_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
      -DCMAKE_SHARED_LINKER_FLAGS="-L/usr/local/cuda/lib64/stubs -lcuda" \
    && cmake --build build --parallel 6 --target sd-cli

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 libcurl4 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/bin/ /app/bin/
ENV LD_LIBRARY_PATH=/app/bin:/usr/local/cuda/lib64
ENTRYPOINT ["/app/bin/sd-cli"]
