# Local paths and provisional profiles. No credentials belong in this file.
MODEL_DIR=/path/to/your/models   # folder that holds your .gguf files (Windows example: C:/AI/models)
HOST_BIND_IP=127.0.0.1
MEDIA_DIR=./media

# Observed host idle usage was about 907 MiB; tune these after the first Docker run.
GPU_IDLE_BASELINE_MIB=1024
GPU_RELEASE_TOLERANCE_MIB=768

UPSTREAM_LLAMA_COMMIT=81bc6b83f827df746eb129235488d325c49cae52
PRISM_LLAMA_COMMIT=adfffbe41b2cabcd51fff326ab045662265062bb
WHISPER_CPP_COMMIT=d09f61a708f3487afa956ff578e60eae5e7a233c
STABLE_DIFFUSION_CPP_COMMIT=3f8527a46c54ecf4cb4ed6003da8e8982283c73c

QWEN_PORT=8080
QWEN_CTX=65536
# RTX 3080 A/B: n=2 is the best measured stable setting (86.7 vs 71.4 tok/s; 69% accepted).
QWEN_SPEC_TYPE=draft-mtp
QWEN_SPEC_N_MAX=2
QWEN_VISION_CTX=32768
QWEN_Q5_CTX=65536

MINICPM_PORT=8080
MINICPM_CTX=65536
# DSpark stays optional: n=4 offered only a small, inconsistent speed gain and weaker short-answer output.
MINICPM_SPEC_TYPE=none
MINICPM_SPEC_N_MAX=
MINICPM_DRAFT_GPU_LAYERS=all

SPARK_PORT=8080
SPARK_CTX=65536
SPARK_KV=f16

BONSAI_PORT=8080
BONSAI_CTX=32768

DUAL_MINICPM_PORT=8083
DUAL_MINICPM_CTX=8192
DUAL_SPARK_PORT=8084
DUAL_SPARK_CTX=16384
DUAL_SPARK_KV=q8_0

WHISPER_PORT=8082
WHISPER_MODEL=/models/302_Whisper-large-v3-turbo/ggml-large-v3-turbo-q8_0.bin

# Qwen Image is a diffusion model; it uses stable-diffusion.cpp, not llama.cpp.
QWEN_IMAGE_MODEL=/models/301_Qwen-Image-2.1/qwen-image-2.1-Q5_K_M.gguf
QWEN_IMAGE_VAE=/models/301_Qwen-Image-2.1/vae/qwen_image_2.1_vae_bf16.safetensors
QWEN_IMAGE_LLM=/models/015_Qwen3-VL-8B/Qwen3VL-8B-Instruct-Q4_K_M.gguf
QWEN_IMAGE_MMPROJ=/models/015_Qwen3-VL-8B/mmproj/mmproj-Qwen3VL-8B-Instruct-F16.gguf

LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=128

# Console reachable from the local network on this address only (127.0.0.1 = this PC only).
AI_CONSOLE_BIND_IP=127.0.0.1   # set the LAN address of this PC to open the console from other devices
# Set a password (HTTP Basic, any user name) before you open the console to the LAN. .env is ignored by Git; never commit it.
AI_CONSOLE_PASSWORD=
# Extra host names (comma separated) that may be used in the browser address bar, for example a name in your LAN DNS.
# localhost and IP addresses are always allowed.
AI_CONSOLE_ALLOWED_HOSTS=
GITEA_WEB_PORT=3010
GITEA_SSH_PORT=2222
GITEA_REPORT_OWNER=reports-admin
GITEA_REPORT_REPO=model-test-reports

# Optional: publish hermes-telemetry on the LAN.
# TELEMETRY_BIND_IP=127.0.0.1
# Optional: address of your public repository; the console and report footers then show a GitHub link.
PUBLIC_REPO_URL=https://github.com/HomenSAI/homensai-local-ai-lab
